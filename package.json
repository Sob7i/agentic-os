{
  "name": "agentic-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "verify": "r=0; pnpm verify:stage1 || r=1; pnpm verify:stage2 || r=1; pnpm verify:stage3 || r=1; exit $r",
    "verify:stage1": "tsx scripts/verify-acceptance.mts",
    "verify:stage2": "tsx scripts/verify-stage2.mts",
    "verify:stage3": "tsx scripts/verify-stage3.mts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.233",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.117.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
